{
  "name": "hovra",
  "productName": "Hovra",
  "private": true,
  "version": "0.0.0",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "sh scripts/build-cursor-visibility-helper.sh && electron-forge start",
    "electron:make": "sh scripts/build-cursor-visibility-helper.sh && electron-forge make && sh scripts/verify-packaged-macos-app.sh",
    "electron:typecheck": "tsc --noEmit -p tsconfig.electron.json",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:gesture-regression": "vitest run src/gesture/gestureRegression.test.ts src/gesture/gestureRegressionSuite.test.ts"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "^43.2.0",
    "jsdom": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "config": {
    "forge": "./forge.config.ts"
  }
}
